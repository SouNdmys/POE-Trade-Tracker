.vs/
.idea/
target/
target-*/
artifacts/
vendor/
.cargo-vendor-config.toml
_to_delete/
*.user
*.suo

# Local gameplay captures are large and may contain private desktop details. Keep the
# compact JSON manifests/corpora in Git, but do not publish raw screenshot fixtures.
tests/screenshots/**/*.png
tests/screenshots/**/*.jpg
tests/screenshots/**/*.jpeg

# Raw test screenshots stay local; only JSON manifests are committed.
test-screenshots/

# POE1 fixture screenshots are the POE1 repo's, mirrored here only to run the
# corpus locally. They stay out of this repo the same way POE2's do.
test-screenshots/poe1/

# zh-TW item-selector screenshots the POE1 catalog's Chinese names were
# transcribed from. Same policy as the other captures: the transcription is in
# the catalog and SHA-256 pinned, so the raw frames stay local.
Currency-screenshots/

# Packaging output
target/package/

# Claude Design handoff exports: 14MB of third-party tool output including raw
# desktop screenshots. Same policy as the capture folders above — the decision
# record they produced is docs/UI-DESIGN.md, which IS committed; the raw
# export stays local.
docs/poe2-ui/
docs/*.zip
